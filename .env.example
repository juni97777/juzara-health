# Pooled URL for application requests on Vercel
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct/non-pooled URL for Prisma schema operations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional: pooled URL from Vercel/Prisma Postgres Marketplace
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"
# Unique random secret, minimum 32 characters
SESSION_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
# Demo staff seeding is disabled in production unless explicitly enabled
ALLOW_DEMO_SEED="false"
DEMO_DOCTOR_PASSWORD=""
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_SUPERADMIN_EMAIL=""
DEMO_SUPERADMIN_PASSWORD=""
